@model IEnumerable<HelpDeskSystem.Models.Customer>

@{
    ViewData["Title"] = "Customers List";
}

<div class="container my-4 pb-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Customers List</h2>
            <p class="text-muted mb-0">Listahan ng lahat ng rehistradong kustomer sa sistema.</p>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-uppercase text-secondary fs-7 fw-semibold">
                            <th class="py-3 ps-4">Company Name</th>
                            <th class="py-3">Contact Name</th>
                            <th class="py-3">Email</th>
                            <th class="py-3 pe-4">Phone</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-3 ps-4 fw-bold text-primary">
                                    @item.CompanyName
                                </td>
                                <td class="py-3 text-dark">
                                    @item.ContactName
                                </td>
                                <td class="py-3">
                                    <a href="mailto:@item.Email" class="text-decoration-none text-secondary">
                                        @item.Email
                                    </a>
                                </td>
                                <td class="py-3 pe-4">
                                    <span class="badge bg-light text-dark border font-monospace fw-normal px-2 py-1">
                                        @item.Phone
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>