<h2>Ticket Details</h2>
<p><strong>Subject:</strong> @Model.Subject</p>
<p><strong>Customer:</strong> @Model.CustomerId</p>
<p><strong>Category:</strong> @Model.CategoryId</p>
<p><strong>Priority:</strong> @Model.PriorityId</p>
<p><strong>Status:</strong> @Model.StatusId</p>

<h3>Assignments</h3>
<ul>
    @foreach (var a in Model.Assignments)
    {
        <li>@a.EmployeeId (Primary: @a.IsPrimary)</li>
    }
</ul>

<h3>Attachments</h3>
<ul>
    @foreach (var att in Model.Attachments)
    {
        <li>@att.FileName</li>
    }
</ul>

<h3>Comments</h3>
<ul>
    @foreach (var c in Model.Comments)
    {
        <li>@c.AuthorId: @c.Text (@c.CreatedAt)</li>
    }
</ul>
