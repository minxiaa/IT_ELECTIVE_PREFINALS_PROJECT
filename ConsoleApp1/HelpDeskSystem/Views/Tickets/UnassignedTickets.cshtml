@model IEnumerable<HelpDeskSystem.Models.Ticket>

@{
    ViewData["Title"] = "Unassigned Tickets";
}

<div class="container my-4 pb-5">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">Unassigned Tickets</h2>
        <p class="text-muted mb-0">List of tickets that have not been assigned to any employee.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-uppercase text-secondary fs-7 fw-semibold">
                            <th class="py-3 ps-4">Subject</th>
                            <th class="py-3">Category</th>
                            <th class="py-3">Priority</th>
                            <th class="py-3 pe-4 text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="py-3 ps-4 fw-bold text-primary">@item.Subject</td>
                                    <td class="py-3">@(item.Category?.Name ?? "N/A")</td>
                                    <td class="py-3">@(item.Priority?.Name ?? "N/A")</td>
                                    <td class="py-3 pe-4 text-end">
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">@(item.Status?.Name ?? "Unassigned")</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    There are currently no unassigned tickets.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>