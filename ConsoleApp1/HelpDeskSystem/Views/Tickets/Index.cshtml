<h2>Tickets</h2>
<form method="get">
    <input type="text" name="search" placeholder="Search tickets..." />
    <button type="submit">Search</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Subject</th>
            <th>Customer</th>
            <th>Category</th>
            <th>Priority</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>
                <td>@ticket.Subject</td>
                <td>@ticket.CustomerId</td>
                <td>@ticket.CategoryId</td>
                <td>@ticket.PriorityId</td>
                <td>@ticket.StatusId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ticket.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@ticket.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@ticket.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
