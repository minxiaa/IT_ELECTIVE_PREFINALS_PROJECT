@model IEnumerable<HelpDeskSystem.Models.ViewModels.DepartmentWorkloadViewModel>

@{
    ViewData["Title"] = "Department Workload Report";
}

<h2 class="mb-4">Department Workload</h2>

@foreach (var item in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <h4 class="card-title text-dark">@item.DepartmentName</h4>
            <p class="mb-1"><strong>Employee Count:</strong> @item.EmployeeCount</p>
            <p class="mb-0"><strong>Unresolved Tickets:</strong> @item.UnresolvedTicketCount</p>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-secondary mt-2">Back to Reports</a>