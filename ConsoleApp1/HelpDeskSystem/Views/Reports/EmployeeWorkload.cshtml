@model IEnumerable<Helpdesksystem.Models.ViewModels.EmployeeWorkloadViewModel>

@{
    ViewData["Title"] = "Employee Workload Report";
}

<div class="container my-4 pb-5">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">Employee Workload Report</h2>
        <p class="text-muted mb-0">Listahan ng bilang ng tickets na hawak ng bawat empleyado.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-uppercase text-secondary fs-7 fw-semibold">
                            <th class="py-3 ps-4">Employee Name</th>
                            <th class="py-3">Department</th>
                            <th class="py-3 pe-4 text-end">Assigned Tickets</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-3 ps-4 fw-bold text-primary">@item.EmployeeName</td>
                                <td class="py-3">@item.DepartmentName</td>
                                <td class="py-3 pe-4 text-end">
                                    <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@item.AssignedTicketCount</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>