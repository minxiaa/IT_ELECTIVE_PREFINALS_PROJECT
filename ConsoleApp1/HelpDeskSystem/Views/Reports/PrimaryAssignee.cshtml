@model IEnumerable<HelpDeskSystem.Models.Ticket>

@{
    ViewData["Title"] = "Primary Assignee Report";
}

<h2>Primary Assignee Report</h2>

<table class="table">
    <thead>
        <tr>
            <th>Ticket Title</th>
            <th>Primary Assignee</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>@ticket.Subject</td>
                    <td>
                        @if (ticket.Assignments != null && ticket.Assignments.Any())
                        {
                            @foreach (var assign in ticket.Assignments)
                            {
                                <span>@assign.Employee?.FullName</span>
                
                                <br />
                            }
                        }
                        else
                        {
                            <span>No Assignee</span>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>