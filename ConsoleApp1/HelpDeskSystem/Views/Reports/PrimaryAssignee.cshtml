@model IEnumerable<HelpDeskSystem.Models.Ticket>

@{
    ViewData["Title"] = "Primary Assignee Report";
}

<h2>Primary Assignee Report</h2>

<table class="table">
    <thead>
        <tr>
            <th>Ticket Title</th>
            <th>Primary Assignee</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.PrimaryAssignee?.Name</td>
                </tr>
            }
        }
    </tbody>
</table>