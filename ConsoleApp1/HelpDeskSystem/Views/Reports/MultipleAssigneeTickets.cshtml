@model IEnumerable<HelpDeskSystem.Models.Ticket>

@{
    ViewData["Title"] = "Multiple Assignee Tickets";
}

<h2>Multiple Assignee Tickets</h2>

<table class="table">
    <thead>
        <tr>
            <th>Subject</th>
            <th>Description</th>
            <th>Assignments</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Subject</td> <!-- Pinalitan mula sa item.Title patungong item.Subject -->
                <td>@item.Description</td>
                <td>
                    @foreach (var assign in item.TicketAssignees)
                    {
                        <span>@assign.Employee?.FullName</span>
                
                        <br />
                    }
                </td>
            </tr>
        }
    </tbody>
</table>