@model IEnumerable<HelpDeskSystem.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="container my-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Departments</h2>
            <p class="text-muted mb-0">Listahan ng lahat ng departamento sa organisasyon.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-uppercase text-secondary fs-7 fw-semibold">
                            <th class="py-3 ps-4">Department ID</th>
                            <th class="py-3 pe-4">Department Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-3 ps-4 text-muted fw-bold">#@item.Id</td>
                                <td class="py-3 pe-4 fw-bold text-primary">@item.Name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>